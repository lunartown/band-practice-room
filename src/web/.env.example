VITE_USE_MOCK_API=true
VITE_API_BASE_URL=/api/v1
# 실제 API 모드에서 /api proxy는 기본적으로 Render prod API를 향한다.
# 로컬 API 또는 Render dev API를 확인할 때만 아래 값을 .env에 추가한다.
# VITE_DEV_API_PROXY_TARGET=http://127.0.0.1:3000
# VITE_DEV_API_PROXY_TARGET=https://hapjusil-api-dev.onrender.com

# 이벤트 계측(PostHog · GA4). 키가 없는 쪽은 아무것도 전송하지 않으므로 로컬 개발에는 비워둔다.
# 배포 환경(Vercel)에만 넣는다.
# VITE_POSTHOG_KEY=phc_xxxxxxxx
# VITE_POSTHOG_HOST=https://us.i.posthog.com
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Meta Pixel(인스타·페이스북 광고 성과 측정). Meta 이벤트 관리자에서 발급한 숫자 ID.
# 광고를 실제로 집행하는 환경(prod)에만 넣는다. 값이 없으면 픽셀은 로드되지 않는다.
# 네이티브 앱(Capacitor)에서는 ID 가 있어도 동작하지 않는다 — 웹 유입 전용이다.
# VITE_META_PIXEL_ID=1234567890123456
